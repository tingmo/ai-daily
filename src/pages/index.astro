---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, formatDate, formatISODate } from '../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [latest, ...rest] = posts;
const recent = rest.slice(0, 5);
---

<BaseLayout active="home" title={null}>
  <section class="hero">
    <span class="eyebrow">投资研究笔记 · 持续更新</span>
    <h1>把产业跟踪、资金数据与舆情信号，整理成可复用的研究框架</h1>
    <p>
      这里是 {SITE.author} 的研究笔记站。围绕半导体与存储产业链、AI 板块的资金与情绪结构做长期跟踪，
      并把每天的数据沉淀到独立的
      <a href={SITE.portalUrl}>AI 每日观察</a> 数据门户里 —— 博客负责「怎么想」，门户负责「今天发生了什么」。
    </p>
    <div class="actions">
      <a class="btn primary" href="/posts/">阅读文章 →</a>
      <a class="btn" href={SITE.portalUrl}>进入 AI 每日观察</a>
      <a class="btn" href="/rss.xml">RSS</a>
    </div>
  </section>

  {
    latest && (
      <section>
        <p class="section-label">Latest</p>
        <ul class="post-list">
          <li class="post-card">
            <div class="meta">
              <span class="cat">{latest.data.category}</span>
              <time datetime={formatISODate(latest.data.date)}>{formatDate(latest.data.date)}</time>
            </div>
            <h2>
              <a href={`/posts/${latest.id}/`}>{latest.data.title}</a>
            </h2>
            {latest.data.summary && <p>{latest.data.summary}</p>}
            {latest.data.tags.length > 0 && (
              <ul class="tags">
                {latest.data.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </li>
        </ul>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section>
        <p class="section-label">Recent</p>
        <ul class="post-list">
          {recent.map((post) => (
            <li class="post-card">
              <div class="meta">
                <span class="cat">{post.data.category}</span>
                <time datetime={formatISODate(post.data.date)}>{formatDate(post.data.date)}</time>
              </div>
              <h2>
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </h2>
              {post.data.summary && <p>{post.data.summary}</p>}
            </li>
          ))}
        </ul>
        {posts.length > recent.length + 1 && (
          <p style="margin-top:20px;">
            <a href="/posts/">查看全部 {posts.length} 篇文章 →</a>
          </p>
        )}
      </section>
    )
  }

  {
    posts.length === 0 && (
      <section>
        <p class="muted">还没有文章，在 src/content/posts/ 里新建 Markdown 文件即可发布。</p>
      </section>
    )
  }

  <section>
    <p class="section-label">Portal</p>
    <div class="hero" style="margin-bottom:0;">
      <span class="eyebrow">每日 09:00 自动更新</span>
      <h1 style="font-size:22px;">AI 每日观察 · 数据门户</h1>
      <p>
        AI 要闻精选、五维舆情指数、AI 概念板块与申万行业主力资金净流入、个股资金榜单，
        以及每条数据的原始出处与核验要点。数据每日自动更新，历史序列持续累积。
      </p>
      <div class="actions">
        <a class="btn primary" href={SITE.portalUrl}>打开门户 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
