---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, formatDate, formatISODate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout
  active="posts"
  title={post.data.title}
  description={post.data.summary || SITE.description}
  article={true}
>
  <article>
    <header class="article-head">
      <div class="meta">
        <span class="cat" style="color:var(--accent-text);background:var(--accent-soft);border-radius:5px;padding:2px 8px;">
          {post.data.category}
        </span>
        <time datetime={formatISODate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && <span>{post.data.tags.map((t) => `#${t}`).join('  ')}</span>}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="lead" style="margin:0;">{post.data.summary}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="article-foot">
      <span>{newer ? <a href={`/posts/${newer.id}/`}>← {newer.data.title}</a> : <a href="/posts/">← 全部文章</a>}</span>
      <span>{older && <a href={`/posts/${older.id}/`}>{older.data.title} →</a>}</span>
    </footer>
  </article>
</BaseLayout>
