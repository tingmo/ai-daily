---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatISODate } from '../../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout active="posts" title="全部文章">
  <h1 class="page-title">全部文章</h1>
  <p class="lead">
    共 {posts.length} 篇，涵盖 {categories.join(' / ')}。按时间倒序排列。
  </p>

  <ul class="post-list" style="margin-top:28px;">
    {
      posts.map((post) => (
        <li class="post-card">
          <div class="meta">
            <span class="cat">{post.data.category}</span>
            <time datetime={formatISODate(post.data.date)}>{formatDate(post.data.date)}</time>
          </div>
          <h2>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h2>
          {post.data.summary && <p>{post.data.summary}</p>}
          {post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
