---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <h1 class="page-title">404 · 页面不存在</h1>
  <p class="lead">你要找的页面可能已经移动或从未存在过。</p>
  <div class="hero" style="margin-top:24px;">
    <p style="margin:0 0 16px;">可以试试这些入口：</p>
    <div class="actions" style="margin-top:0;">
      <a class="btn primary" href="/">返回首页</a>
      <a class="btn" href="/posts/">全部文章</a>
      <a class="btn" href="/daily/">AI 每日观察</a>
    </div>
  </div>
</BaseLayout>
